# syntax=docker/dockerfile:1.7
# v4 candidate: same as v3 + AOT cache (JEP 514) built via a training stage.
# 3 stages: build jar → AOT training (produces /app/app.aot) → runtime with -XX:AOTCache.
#
# Build:  docker build --platform linux/amd64 -t luccarhaddad/rinha2026-java:faiss-v4 -f api/Dockerfile.v4 .

# ---- stage 1: compile the jar ----
FROM eclipse-temurin:25-jdk AS build
RUN apt-get update && apt-get install -y --no-install-recommends maven && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY api/pom.xml /src/api/pom.xml
RUN cd api && mvn -B -q -DskipTests dependency:go-offline || true
COPY api/src /src/api/src
RUN cd api && mvn -B -q -DskipTests clean package

# ---- stage 2: AOT cache training ----
# Runs the app with TRAINING=1 to exit cleanly after warmup; AOTCacheOutput
# captures loaded classes + method profiles for the runtime stage.
# MUST match runtime base image — AOT cache validates lib/modules size.
FROM eclipse-temurin:25-jre AS aot-train
RUN apt-get update && apt-get install -y --no-install-recommends \
        libopenblas0 libgomp1 libgfortran5 && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /app/resources /usr/local/lib
COPY vendor/linux-amd64/libfaiss.so       /usr/local/lib/
COPY vendor/linux-amd64/libfaiss_avx2.so  /usr/local/lib/
COPY vendor/linux-amd64/libfaiss_c.so     /usr/local/lib/
RUN ldconfig
COPY --from=build /src/api/target/api.jar /app/api.jar
COPY api/src/main/resources/data.faiss    /app/resources/data.faiss
COPY api/src/main/resources/labels.bin    /app/resources/labels.bin
ENV LD_LIBRARY_PATH=/usr/local/lib \
    FAISS_C_LIB_PATH=/usr/local/lib/libfaiss_c.so \
    FAISS_INDEX=/app/resources/data.faiss \
    LABELS_BIN=/app/resources/labels.bin \
    KERNEL=faiss \
    FAISS_NPROBE=8 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    TRAINING=1 \
    WARMUP_ITERS=400
# Use the same runtime JVM flags during training so the cache is valid at runtime.
RUN java \
    --add-modules=jdk.incubator.vector \
    --enable-native-access=ALL-UNNAMED \
    -XX:AOTCacheOutput=/app/app.aot \
    -XX:+UseG1GC \
    -Xmx32m \
    -XX:MaxMetaspaceSize=40m \
    -XX:ReservedCodeCacheSize=32m \
    -jar /app/api.jar

# ---- stage 3: runtime ----
FROM eclipse-temurin:25-jre AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
        libopenblas0 libgomp1 libgfortran5 && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /app/resources /usr/local/lib

COPY vendor/linux-amd64/libfaiss.so       /usr/local/lib/
COPY vendor/linux-amd64/libfaiss_avx2.so  /usr/local/lib/
COPY vendor/linux-amd64/libfaiss_c.so     /usr/local/lib/
COPY vendor/linux-amd64/FAISS-LICENSE     /usr/local/lib/
RUN ldconfig

COPY --from=build     /src/api/target/api.jar     /app/api.jar
COPY --from=aot-train /app/app.aot                /app/app.aot
COPY api/src/main/resources/data.faiss            /app/resources/data.faiss
COPY api/src/main/resources/labels.bin            /app/resources/labels.bin

ENV LD_LIBRARY_PATH=/usr/local/lib \
    FAISS_C_LIB_PATH=/usr/local/lib/libfaiss_c.so \
    FAISS_INDEX=/app/resources/data.faiss \
    LABELS_BIN=/app/resources/labels.bin \
    KERNEL=faiss \
    FAISS_NPROBE=8 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    PORT=8080
EXPOSE 8080
ENTRYPOINT ["java", \
    "--add-modules=jdk.incubator.vector", \
    "--enable-native-access=ALL-UNNAMED", \
    "-XX:AOTCache=/app/app.aot", \
    "-XX:+UseG1GC", \
    "-Xmx32m", \
    "-XX:MaxMetaspaceSize=40m", \
    "-XX:ReservedCodeCacheSize=32m", \
    "-XX:ActiveProcessorCount=1", \
    "-XX:+UseTransparentHugePages", \
    "-XX:-UsePerfData", \
    "-jar", "/app/api.jar"]
